{
  "name": "olympus-sng-worker",
  "private": true,
  "description": "올림포스 도시 백엔드 — Cloudflare Worker (D1 + Durable Objects). server-legacy(Node/SQLite)를 D1 기반으로 재이식.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "db:migrate:local": "wrangler d1 migrations apply olympus-sng-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply olympus-sng-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.121.0",
    "@cloudflare/workers-types": "^5.20260811.1"
  },
  "dependencies": {
    "hono": "^4.13.1"
  }
}
