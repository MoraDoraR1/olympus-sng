// 로컬 API 통합 테스트 전용 설정 — wrangler.jsonc와 동일하지만 assets 바인딩(레포 루트
// 정적 파일 서빙)만 뺐다. 일부 로컬 환경(파일감시자 인스턴스 제한이 낮은 샌드박스 등)에서는
// "assets.directory": "../"를 켠 채로 `wrangler dev`를 띄우면 워커가 계속 리로드를 반복해
// 포트가 응답하지 않는 경우가 있었다 — 정적 자산 없이 API만 검증할 때는 이 설정을 쓴다.
// 실제 배포에는 절대 쓰지 않는다(항상 wrangler.jsonc로 deploy).
//   npx wrangler dev --config wrangler.dev-api-only.jsonc --port 8790
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "olympus-sng",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "olympus-sng-db",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "PVP_COORDINATOR", "class_name": "PvpCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PvpCoordinator"] }
  ],

  "observability": { "enabled": true }
}
