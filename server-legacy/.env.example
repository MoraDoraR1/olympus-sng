# 이 파일을 server/.env로 복사한 뒤 실제 값으로 채우세요.
#   cp .env.example .env
# server/.env는 .gitignore에 의해 절대 커밋되지 않습니다 — 이 저장소(및 그걸 그대로
# 서빙하는 GitHub Pages 등)가 통째로 공개되어 있어도, .env에 적은 값은 공개되지 않습니다.

# 필수(운영 배포 시): JWT 로그인 토큰 서명에 쓰이는 비밀값.
# 아래 명령으로 안전한 무작위 값을 생성해서 넣으세요.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 비워두면 서버가 최초 실행 시 server/data/.jwt-secret에 이 인스턴스 전용 값을
# 자동 생성해 재사용합니다(로컬 테스트 용도). 실제 배포에서는 반드시 직접 설정하세요.
JWT_SECRET=

# 선택
PORT=8787
CORS_ORIGIN=*
